{
  "name": "training-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "generate:icons": "node scripts/generate-icons.mjs",
    "test:mock": "node scripts/test-mock-api.mjs",
    "test:nutrition": "node scripts/test-nutrition.mjs",
    "test:goals": "node scripts/test-goals.mjs",
    "test:ui": "playwright test",
    "test:ui:production": "PW_PREVIEW=1 playwright test",
    "test:live": "playwright test --config playwright.live.config.ts",
    "test:live:production": "PW_PREVIEW=1 playwright test --config playwright.live.config.ts",
    "export:catalogue": "node scripts/export-server-catalogue.mjs",
    "generate:art": "node scripts/generate-preview-art.mjs",
    "test:expert": "node scripts/test-expert.mjs"
  },
  "dependencies": {
    "@vite-pwa/sveltekit": "1.1.0",
    "bits-ui": "^2.18.1",
    "lucide-svelte": "0.468.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@sveltejs/adapter-node": "5.5.4",
    "@sveltejs/kit": "2.59.1",
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "@types/node": "24.12.3",
    "svelte": "5.55.5",
    "svelte-check": "4.4.8",
    "typescript": "5.9.3",
    "vite": "8.0.11"
  }
}
